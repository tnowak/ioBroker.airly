{
  "i18n": true,
  "type": "panel",
  "items": {
    "apikey": {
      "type": "password",
      "label": "Airly API key",
      "help": "Get one at developer.airly.org",
      "sm": 12,
      "md": 6,
      "newLine": true
    },
    "latitude": {
      "type": "text",
      "label": "Latitude",
      "placeholder": "52.165814",
      "sm": 12,
      "md": 3,
      "newLine": true
    },
    "longitude": {
      "type": "text",
      "label": "Longitude",
      "placeholder": "21.046181",
      "sm": 12,
      "md": 3
    },
    "mode": {
      "type": "select",
      "label": "Data source",
      "options": [
        { "label": "Interpolated point (recommended)", "value": "point" },
        { "label": "Nearest station", "value": "nearest" }
      ],
      "default": "point",
      "help": "Point: Airly interpolates for your exact coordinates. Nearest: data from the closest physical station.",
      "sm": 12,
      "md": 6,
      "newLine": true
    },
    "maxDistanceKM": {
      "type": "number",
      "label": "Max distance (km)",
      "min": 1,
      "max": 100,
      "default": 25,
      "help": "Only used in 'Nearest station' mode.",
      "hidden": "data.mode === 'point'",
      "sm": 12,
      "md": 3,
      "newLine": true
    },
    "pollInterval": {
      "type": "number",
      "label": "Poll interval (minutes)",
      "min": 5,
      "max": 1440,
      "default": 20,
      "help": "Airly free tier allows a limited number of requests per day",
      "sm": 12,
      "md": 3
    }
  }
}
